#!/bin/zsh
# SPDX-License-Identifier: MPL-2.0

set -e

script_dir="${0:A:h}"
repo="${script_dir:h}"
binary="$repo/.build/debug/pocketctrl"
source="$repo/Sources/PocketCtrlHostCLI/main.swift"

# Prefer a full Xcode toolchain; honor an existing DEVELOPER_DIR override.
if [[ -z "${DEVELOPER_DIR:-}" && -d /Applications/Xcode.app/Contents/Developer ]]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi

if [[ ! -x "$binary" || "$repo/Package.swift" -nt "$binary" || "$source" -nt "$binary" ]]; then
  xcrun swift build --package-path "$repo" --product pocketctrl
fi

exec "$binary" "$@"
