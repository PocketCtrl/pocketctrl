#!/bin/zsh
# SPDX-License-Identifier: MPL-2.0

set -e

script_dir="${0:A:h}"
repo="${script_dir:h}"
binary="$repo/.build/debug/pocketctrl"
source="$repo/Sources/PocketCtrlHostCLI/main.swift"

if [[ ! -x "$binary" || "$repo/Package.swift" -nt "$binary" || "$source" -nt "$binary" ]]; then
  DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer \
    /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift \
    build --package-path "$repo" --product pocketctrl
fi

exec "$binary" "$@"
